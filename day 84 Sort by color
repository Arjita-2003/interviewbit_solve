public class Solution {
	public void sortColors(ArrayList<Integer> a) {
        int one = 0;
        int two = 0;
        int zero = 0;
        for(int i =0; i<a.size();i++){
            if(a.get(i)==0) zero++;
            else if(a.get(i)==1) one++;
            else if(a.get(i)==2) two++;
        }
        for(int j=0;j<a.size();j++){
            if(zero!=0){
                a.set(j,0);
                zero--;
            }
            else if(one!=0){
                a.set(j,1);
                one--;
            }
            else if(two!=0){
                a.set(j,2);
                two--;
            }
        }
        
	}
}
